# Mock Mode Switch
# Defaults to "false" when unset (connects to FastAPI backend at http://localhost:8000)
# Set strictly to "true" to enable standalone offline mock fixtures and error simulation
VITE_USE_MOCK=false

# Optional: override API base URL (defaults to relative "/api" proxied to backend)
# VITE_API_BASE=/api

# Optional: backend target for Vite dev server proxy (defaults to http://localhost:8000)
# VITE_BACKEND_TARGET=http://localhost:8000
