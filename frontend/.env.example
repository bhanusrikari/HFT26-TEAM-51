# Set to "true" to use realistic local mock data without a running backend
# Set to "false" to connect to the FastAPI backend (http://localhost:8000)
VITE_USE_MOCK=false

# API base URL for FastAPI backend
VITE_API_BASE=http://localhost:8000/api

# Backend target for Vite dev server proxy
VITE_BACKEND_TARGET=http://localhost:8000
